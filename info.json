{
  "name": "reskins-nullius-hurricane",
  "version": "0.2.0",
  "title": "Artisanal Reskins: Nullius Hurricane",
  "author": "brickbrycebrick",
  "factorio_version": "2.1",
  "dependencies": [
    "base >= 2.1",
    "nullius",
    "reskins-framework >= 0.2.1",
    "? reskins-nullius",
    "? tricky-old-nick",
    "? lambent-nil",
    "? configurable-valves",
    "? nullius-visual-tweaks"
  ],
  "package": {
    "ignore": [
      ".work",
      ".work/*",
